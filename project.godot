; Engine configuration file.

config_version=5

[application]

config/name="Crash Circuit"
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input]

accelerate={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
brake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
steer_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
steer_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
reset_car={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
cycle_camera={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67)]
}
toggle_debug={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}

[physics]

3d/default_gravity=14.0
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.38, 0.6, 0.82, 1)
